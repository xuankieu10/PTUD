# Database Configuration (SQL Server ODBC Driver 17)
DATABASE_URL=mssql+pyodbc://localhost/HocVuAI?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# JWT Authentication
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRE_MINUTES=60

# Admin Seed Account
ADMIN_USER=admin
ADMIN_PASSWORD=change_me

# Ollama Service & Models (Mặc định 7b/7b/7b)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
REWRITE_MODEL=qwen2.5:7b
VLM_MODEL=qwen2.5vl:7b
EMBED_MODEL=bge-m3
EMBEDDING_MODEL=bge-m3
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Runtime & Context
NUM_CTX=4096
OLLAMA_NUM_CTX=4096
KEEP_ALIVE=15m
OLLAMA_KEEP_ALIVE=15m
VLM_KEEP_ALIVE=0s
MAX_IMAGE_DIM=1280
OLLAMA_NUM_PREDICT=1000
ADVISORY_USE_LLM=true
OLLAMA_TIMEOUT_CHAT=300
OLLAMA_TIMEOUT_EMBED=180
OCR_TIMEOUT_SECONDS=300
OLLAMA_TIMEOUT_OCR=300

# RAG & Debug
CHUNK_SIZE=600
CHUNK_OVERLAP=80
TOP_K=4
SIMILARITY_THRESHOLD=0.35
MIN_SCORE_THRESHOLD=0.6
DEBUG_MODE=false
MAX_CHUNK_CHARS=600

# Quy định tốt nghiệp & Giới hạn học vụ
REQUIRED_CREDITS=150
MIN_GRADUATION_GPA=5.0  # Nguồn: QĐ 1013/QĐ-ĐHLH Mục A.1.2 (GPA toàn khóa >= 5.0 thang 10)
SUGGESTED_CREDITS_PER_SEMESTER=20  # Gợi ý tiến độ học kỳ chính (giả định của hệ thống)
SUGGESTED_CREDITS_SUMMER=8  # Gợi ý tiến độ học kỳ hè (giả định của hệ thống)
MAX_CREDITS_PER_SEMESTER=20  # Alias tương thích ngược
MAX_CREDITS_SUMMER=8  # Alias tương thích ngược
MAX_STANDARD_SEMESTERS=8  # Nguồn: Niên giám 2023 Mục 7.1
MAX_EXTENDED_SEMESTERS=12  # Nguồn: QĐ 22 Điều 3 Khoản 1

# Cổng thông tin đào tạo LHU (DKMH)
LHU_PORTAL_URL=https://tapi.lhu.edu.vn
DAO_TAO_OFFICE=B101, Cơ sở 1
DKMH_URL=https://dkmh.lhu.edu.vn
GPA4_ROUND_1DP=false
