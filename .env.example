# Database Configuration (SQL Server ODBC Driver 17)
DATABASE_URL=mssql+pyodbc://@localhost/HocVuAI?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# JWT Authentication
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRE_MINUTES=60

# Admin Seed Account
ADMIN_USER=admin
ADMIN_PASSWORD=change_me

# Ollama Service
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
LLM_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
VISION_MODEL=qwen2.5vl:3b

# RAG & Chunking Parameters
CHUNK_SIZE=600
CHUNK_OVERLAP=80
TOP_K=3
SIMILARITY_THRESHOLD=0.35
MIN_SCORE_THRESHOLD=0.6
MAX_CHUNK_CHARS=600

# Graduation Rules
REQUIRED_CREDITS=150

# Ollama Runtime Optimization
OLLAMA_TIMEOUT_EMBED=180
OLLAMA_TIMEOUT_CHAT=300
OCR_TIMEOUT_SECONDS=300
OLLAMA_TIMEOUT_OCR=300
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=300
# OLLAMA_NUM_THREAD=4
# OLLAMA_NUM_BATCH=512
